package web

import (
	"strconv"

	"github.com/kvitrvn/raun/internal/knowledge"
	"github.com/kvitrvn/raun/internal/web/ui"
)

templ document(m pageModel) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"historyCacheSize":0,"historyRestoreAsHxRequest":false,"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[2345]..","swap":true},{"code":"...","swap":false}]}'/>
			<title>{ m.Title } · { m.Project } · Raun</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body hx-boost="true" hx-target="#app" hx-select="#app" hx-swap="outerHTML" hx-push-url="true" hx-sync="body:replace" hx-history="false">
			<a class="skip-link" href="#main" hx-boost="false">Skip to content</a>
			@app(m)
			<p id="navigation-status" class="sr-only" role="status" aria-live="polite"></p>
		</body>
	</html>
}

templ fragment(m pageModel) {
	<title>{ m.Title } · { m.Project } · Raun</title>
	@app(m)
}

templ app(m pageModel) {
	<div
		id="app"
		class="app"
		if m.Explicit {
			data-view="detail"
		} else {
			data-view="list"
		}
	>
		@sidebar(m)
		<div class="app-body">
			@topbar(m)
			<main id="main" tabindex="-1" class="app-main">
				if m.Counts == nil {
					<div class="page-error">
						<h1>{ m.Title }</h1>
						if m.Decision != nil {
							@decisionPanel(m, m.Decision)
						} else {
							<p id="error-summary" role="alert" tabindex="-1" autofocus>{ m.Error }</p>
						}
						<a href="/knowledge">Return to knowledge</a>
					</div>
				} else {
					@listColumn(m)
					@detailColumn(m)
				}
			</main>
		</div>
		if m.Counts != nil {
			@palette(m)
		}
		@ui.HoverCardContent("evidence-preview")
	</div>
}

templ sidebar(m pageModel) {
	@ui.Sidebar("Workspace") {
		@ui.SidebarHeader("") {
			<img src="/assets/favicon.svg" alt="" width="28" height="28" class="sidebar-logo"/>
			<span class="sidebar-project">
				<span class="sidebar-project-name">{ m.Project }</span>
				<span class="sidebar-project-note">Local workspace</span>
			</span>
		}
		@ui.SidebarContent("Knowledge navigation") {
			@ui.SidebarGroup() {
				@ui.SidebarGroupLabel("nav-knowledge") {
					Knowledge
				}
				@ui.SidebarMenu("nav-knowledge") {
					@navItem(m, m.Filters.withType("").url(m.selectedID()), m.Filters.Type == "", "layout-list", "All knowledge", func(c *counts) int { return c.Total })
					@navItem(m, m.Filters.withType(string(knowledge.TypePersona)).url(m.selectedID()), m.Filters.Type == string(knowledge.TypePersona), "users", "Personas", func(c *counts) int { return c.Personas })
					@navItem(m, m.Filters.withType(string(knowledge.TypeRequirement)).url(m.selectedID()), m.Filters.Type == string(knowledge.TypeRequirement), "scroll-text", "Requirements", func(c *counts) int { return c.Requirements })
				}
			}
			@ui.SidebarGroup() {
				@ui.SidebarGroupLabel("nav-review") {
					Review
				}
				@ui.SidebarMenu("nav-review") {
					@navItem(m, m.Filters.withStatus(statusPending).url(m.selectedID()), m.Filters.Status == statusPending, "inbox", "Awaiting decision", func(c *counts) int { return c.Pending })
					@navItem(m, m.Filters.withStatus(string(knowledge.StatusContested)).url(m.selectedID()), m.Filters.Status == string(knowledge.StatusContested), "split", "Contested", func(c *counts) int { return c.status(knowledge.StatusContested) })
					@navItem(m, m.Filters.withStatus(string(knowledge.StatusNeedsReview)).url(m.selectedID()), m.Filters.Status == string(knowledge.StatusNeedsReview), "refresh-cw", "Needs review", func(c *counts) int { return c.status(knowledge.StatusNeedsReview) })
				}
			}
		}
		@ui.SidebarFooter("") {
			<span class="sidebar-mode">
				if m.ReadOnly {
					<span class="sidebar-mode-dot" data-mode="read-only"></span>
					Read-only consultation
				} else {
					<span class="sidebar-mode-dot" data-mode="decisions"></span>
					Human decisions enabled
				}
			</span>
			if m.Author != "" {
				<span class="sidebar-author">Signed as { m.Author }</span>
			}
			<span class="sidebar-address">{ m.Host }</span>
		}
	}
}

templ navItem(m pageModel, href string, active bool, icon, label string, count func(*counts) int) {
	@ui.SidebarMenuItem() {
		@ui.SidebarMenuButton(href, active && m.Counts != nil) {
			@ui.Icon(icon)
			<span class="sidebar-menu-label">{ label }</span>
			if m.Counts != nil {
				@ui.SidebarMenuBadge() {
					{ strconv.Itoa(count(m.Counts)) }
				}
			}
		}
	}
}

templ topbar(m pageModel) {
	<header class="topbar">
		@ui.SidebarTrigger()
		@ui.Separator("vertical", "topbar-separator")
		@ui.Breadcrumb("topbar-breadcrumb") {
			if it := m.Item; it != nil && m.NotFound == "" {
				@ui.BreadcrumbItem("") {
					{ m.Project }
				}
				@ui.BreadcrumbSeparator()
				@ui.BreadcrumbItem("") {
					{ typePlural(it.Type) }
				}
				@ui.BreadcrumbSeparator()
				@ui.BreadcrumbItem("topbar-breadcrumb-page") {
					@ui.BreadcrumbPage("topbar-breadcrumb-id") {
						{ it.ID }
					}
				}
			} else {
				@ui.BreadcrumbItem("topbar-breadcrumb-page") {
					@ui.BreadcrumbPage("") {
						{ m.Project }
					}
				}
			}
		}
		<span class="topbar-spacer"></span>
		if m.Counts != nil {
			<a href="#q" data-slot="command-trigger" class="command-trigger" aria-controls="command" hx-boost="false">
				@ui.Icon("search", ui.IconProps{Size: 15})
				<span class="command-trigger-label">Jump to knowledge…</span>
				@ui.Kbd(ui.KbdMuted, "", "command-trigger-kbd") {
					@ui.ModKey("K")
				}
			</a>
		}
	</header>
}

templ palette(m pageModel) {
	@ui.CommandDialog("command", "Jump to knowledge") {
		@ui.CommandInput("command-list", "Search knowledge or jump to a view…") {
			@ui.Kbd(ui.KbdMuted, "", "command-esc") {
				esc
			}
		}
		@ui.CommandList("command-list", "Knowledge") {
			@ui.CommandEmpty()
			@ui.CommandGroup("command-views", "Views") {
				@paletteView(m.Filters.withType("").withStatus(statusPending).url(m.selectedID()), "inbox", "Awaiting decision")
				@paletteView(m.Filters.withType("").withStatus(string(knowledge.StatusContested)).url(m.selectedID()), "split", "Contested")
				@paletteView(m.Filters.withType("").withStatus(string(knowledge.StatusNeedsReview)).url(m.selectedID()), "refresh-cw", "Needs review")
				@paletteView(m.Filters.withType("").withStatus(statusAll).url(m.selectedID()), "layout-list", "All knowledge")
			}
			for _, t := range knowledge.Types {
				if hasType(m.Palette, t) {
					@ui.CommandGroup("command-"+string(t), typePlural(t)) {
						for _, it := range m.Palette {
							if it.Type == t {
								@ui.CommandItem(m.Filters.url(it.ID), it.ID+" "+it.Title) {
									@ui.Icon(typeIcon(t))
									<span class={ "status-dot command-item-dot tone-" + string(it.Status) }></span>
									<span class="command-item-label">{ it.Title }</span>
									<span class="command-item-hint">{ it.ID }</span>
								}
							}
						}
					}
				}
			}
		}
		@ui.CommandFooter() {
			<span class="command-footer-hint">
				@ui.Kbd(ui.KbdOutline, ui.KbdSizeSm, "") {
					↑
				}
				@ui.Kbd(ui.KbdOutline, ui.KbdSizeSm, "") {
					↓
				}
				select
			</span>
			<span class="command-footer-hint">
				@ui.Kbd(ui.KbdOutline, ui.KbdSizeSm, "") {
					↵
				}
				open
			</span>
		}
	}
}

templ paletteView(href, icon, label string) {
	@ui.CommandItem(href, label) {
		@ui.Icon(icon)
		<span class="command-item-label">{ label }</span>
		<span class="command-item-hint"></span>
	}
}

func hasType(items []*knowledge.Item, t knowledge.Type) bool {
	for _, it := range items {
		if it.Type == t {
			return true
		}
	}
	return false
}
