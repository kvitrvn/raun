package ui

templ Button() {
	<button type="submit" data-slot="button" class="cn-button inline-flex items-center justify-center">
		{ children... }
	</button>
}

templ Badge() {
	<span data-slot="badge" class="cn-badge inline-flex items-center">
		{ children... }
	</span>
}

templ Card() {
	<div data-slot="card" class="cn-card flex flex-col">
		{ children... }
	</div>
}

templ Input(id, name, value string) {
	<input id={ id } name={ name } value={ value } type="search" data-slot="input" class="cn-input w-full min-w-0"/>
}

templ Pagination(previous, next, label string) {
	<nav aria-label="Pagination" data-slot="pagination" class="flex flex-wrap items-center gap-4">
		if previous != "" {
			<a href={ templ.SafeURL(previous) } data-slot="pagination-link" class="cn-button cn-button-outline" rel="prev">Previous</a>
		}
		<span>{ label }</span>
		if next != "" {
			<a href={ templ.SafeURL(next) } data-slot="pagination-link" class="cn-button cn-button-outline" rel="next">Next</a>
		}
	</nav>
}
