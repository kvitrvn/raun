// See ../licenses/shadcn-templ.txt and ../../../docs/web.md.
package ui

type ButtonVariant string

type ButtonSize string

const (
	ButtonDefault ButtonVariant = "default"
	ButtonOutline ButtonVariant = "outline"
	ButtonGhost   ButtonVariant = "ghost"

	ButtonSizeDefault ButtonSize = "default"
	ButtonSizeSm      ButtonSize = "sm"
	ButtonSizeIcon    ButtonSize = "icon"
)

// ButtonProps renders a link when Href is set, otherwise a button of Type
// (default "button").
type ButtonProps struct {
	Variant  ButtonVariant
	Size     ButtonSize
	Type     string
	Href     string
	Class    string
	Disabled bool
	Attrs    templ.Attributes
}

func (p ButtonProps) class() string {
	variant, size := p.Variant, p.Size
	if variant == "" {
		variant = ButtonDefault
	}
	if size == "" {
		size = ButtonSizeDefault
	}
	return cn("cn-button cn-button-variant-"+string(variant), "cn-button-size-"+string(size), p.Class)
}

templ Button(p ButtonProps) {
	if p.Href != "" {
		<a href={ templ.SafeURL(p.Href) } data-slot="button" class={ p.class() } { p.Attrs... }>
			{ children... }
		</a>
	} else {
		<button
			if p.Type == "" {
				type="button"
			} else {
				type={ p.Type }
			}
			data-slot="button"
			class={ p.class() }
			disabled?={ p.Disabled }
			{ p.Attrs... }
		>
			{ children... }
		</button>
	}
}
