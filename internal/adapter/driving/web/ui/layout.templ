package ui

import "encoding/json"

// Assets holds the URLs of the embedded assets, content-hashed by the
// server.
type Assets struct {
	CSS     string
	ThemeJS string
	AppJS   string
	HTMX    string
	Icon    string
}

// NavItem is a link of the top bar. Only pages that exist are listed.
type NavItem struct {
	Label   string
	Href    string
	Current bool
}

// Page holds what the layout needs around the content of a page.
type Page struct {
	// Title names the page; the layout appends the product name.
	Title string
	// Instance is the host of the public address, shown in the top bar.
	Instance string
	Assets   Assets
	Nav      []NavItem
	Flash    []Flash
	// CSRF is the token of the session of the request, empty without one.
	// HTMX sends it on every request; forms carry it with CSRFField.
	CSRF string
}

// csrfHeaders is the JSON of the hx-headers attribute that sends the CSRF
// token of the session with every HTMX request.
func csrfHeaders(token string) string {
	b, _ := json.Marshal(map[string]string{"X-CSRF-Token": token})
	return string(b)
}

func (p Page) documentTitle() string {
	if p.Title == "" {
		return "Raun"
	}
	return p.Title + " · Raun"
}

// htmxConfig turns off what the Content Security Policy forbids: eval,
// script tags in swapped content and the injected indicator style. History
// snapshots are off, so going back asks the server again.
const htmxConfig = `{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0,"selfRequestsOnly":true}`

// Layout is the document of every page: the head with the assets, the top
// bar, the flash messages and the main region.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.documentTitle() }</title>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="icon" type="image/svg+xml" href={ p.Assets.Icon }/>
			<link rel="stylesheet" href={ p.Assets.CSS }/>
			<script src={ p.Assets.ThemeJS }></script>
			<script src={ p.Assets.HTMX } defer></script>
			<script src={ p.Assets.AppJS } defer></script>
		</head>
		<body
			class="flex min-h-screen flex-col bg-ground text-foreground"
			if p.CSRF != "" {
				hx-headers={ csrfHeaders(p.CSRF) }
			}
		>
			<a class="cn-skip-link" href="#main">Skip to content</a>
			@topbar(p)
			if len(p.Flash) > 0 {
				<div data-slot="flash" class="mx-auto flex w-full max-w-[1280px] flex-col gap-2 px-8 pt-4">
					for _, f := range p.Flash {
						@Toast(f)
					}
				</div>
			}
			<main id="main" class="mx-auto flex w-full max-w-[1280px] flex-1 flex-col gap-6 px-8 pt-8 pb-12 max-sm:px-4">
				{ children... }
			</main>
		</body>
	</html>
}

templ topbar(p Page) {
	<header data-slot="topbar" class="flex min-h-16 flex-wrap items-center gap-x-5 gap-y-2 border-b border-border bg-background px-6 max-sm:px-4">
		<a href="/" class="flex items-center gap-2.5" aria-label="Raun home">
			<span class="grid size-[30px] place-items-center rounded-[7px] bg-primary text-primary-foreground">
				@Icon(IconRune, IconProps{Class: "size-[18px]"})
			</span>
			<span class="text-lg font-semibold tracking-tight">raun</span>
		</a>
		if p.Instance != "" {
			<span class="h-6 w-px bg-border" aria-hidden="true"></span>
			<span class="font-mono text-[12.5px] text-muted-foreground">{ p.Instance }</span>
		}
		if len(p.Nav) > 0 {
			<nav aria-label="Main" class="flex gap-0.5">
				for _, n := range p.Nav {
					<a
						class="cn-nav-link"
						href={ templ.URL(n.Href) }
						if n.Current {
							aria-current="page"
						}
					>{ n.Label }</a>
				}
			</nav>
		}
		<span class="flex-1"></span>
		<button type="button" class={ ButtonClasses(ButtonProps{Variant: ButtonGhost, Size: ButtonIcon, Class: "cn-theme-toggle"}) } data-theme-toggle aria-label="Switch theme">
			@Icon(IconMoon, IconProps{Class: "cn-when-light"})
			@Icon(IconSun, IconProps{Class: "cn-when-dark"})
		</button>
	</header>
}
