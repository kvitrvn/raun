package ui

// IconName names an icon of the set. Icons are drawn as markup here, never
// loaded or passed raw: a 16-unit grid, a 1.5 to 1.8 stroke, round caps.
type IconName string

const (
	IconRune        IconName = "rune"
	IconCheck       IconName = "check"
	IconX           IconName = "x"
	IconPlus        IconName = "plus"
	IconSearch      IconName = "search"
	IconMore        IconName = "more"
	IconChevronDown IconName = "chevron-down"
	IconArrowLeft   IconName = "arrow-left"
	IconCopy        IconName = "copy"
	IconExternal    IconName = "external"
	IconFolder      IconName = "folder"
	IconSun         IconName = "sun"
	IconMoon        IconName = "moon"
	// Discs: a filled circle with a white glyph, for statuses. Their
	// colour comes from the class the caller gives (text-success, ...).
	IconDiscCheck IconName = "disc-check"
	IconDiscDot   IconName = "disc-dot"
	IconDiscSwap  IconName = "disc-swap"
	IconDiscAlert IconName = "disc-alert"
	IconDiscCross IconName = "disc-cross"
)

// IconProps tunes an icon. Label makes it an image with that name for
// assistive technologies; without it the icon is decoration and hidden.
type IconProps struct {
	Class string
	Label string
}

templ Icon(name IconName, props ...IconProps) {
	{{ var p IconProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<svg
		viewBox="0 0 16 16"
		class={ classes("cn-icon shrink-0", p.Class) }
		data-icon={ string(name) }
		if p.Label != "" {
			role="img"
			aria-label={ p.Label }
		} else {
			aria-hidden="true"
		}
		focusable="false"
	>
		switch name {
			case IconRune:
				<path d="M5.2 2.4v11.2M5.2 2.8l5.2 2.9-5.2 2.8M5.2 8.5l6 5.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconCheck:
				<path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconX:
				<path d="M4.5 4.5l7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			case IconPlus:
				<path d="M8 3.5v9M3.5 8h9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
			case IconSearch:
				<circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
				<path d="M10.5 10.5L14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
			case IconMore:
				<circle cx="3.5" cy="8" r="1.2" fill="currentColor"></circle>
				<circle cx="8" cy="8" r="1.2" fill="currentColor"></circle>
				<circle cx="12.5" cy="8" r="1.2" fill="currentColor"></circle>
			case IconChevronDown:
				<path d="M4.5 6.5L8 10l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconArrowLeft:
				<path d="M10 4L6 8l4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconCopy:
				<rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
				<path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
			case IconExternal:
				<path d="M6 3h7v7M13 3L6 10M11 9.5V13H3V5h3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconFolder:
				<path d="M2.5 4.5a1 1 0 0 1 1-1h3l1.5 1.5h4.5a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
			case IconSun:
				<circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
				<path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
			case IconMoon:
				<path d="M13 9.6A5.5 5.5 0 0 1 6.4 3a5.5 5.5 0 1 0 6.6 6.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
			case IconDiscCheck:
				<circle cx="8" cy="8" r="8" fill="currentColor"></circle>
				<path d="M4.7 8.3l2.2 2.2 4.4-4.7" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconDiscDot:
				<circle cx="8" cy="8" r="8" fill="currentColor"></circle>
				<circle cx="8" cy="8" r="2.6" fill="none" stroke="#fff" stroke-width="1.7"></circle>
			case IconDiscSwap:
				<circle cx="8" cy="8" r="8" fill="currentColor"></circle>
				<path d="M4.8 6.3h6.4M9.6 4.7l1.6 1.6-1.6 1.6M11.2 9.7H4.8M6.4 8.1L4.8 9.7l1.6 1.6" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			case IconDiscAlert:
				<circle cx="8" cy="8" r="8" fill="currentColor"></circle>
				<path d="M8 4.4v4.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round"></path>
				<circle cx="8" cy="11.3" r="1" fill="#fff"></circle>
			case IconDiscCross:
				<circle cx="8" cy="8" r="8" fill="currentColor"></circle>
				<path d="M5.5 5.5l5 5M10.5 5.5l-5 5" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round"></path>
		}
	</svg>
}
