<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Repositories · Raun</title><meta name="htmx-config" content="{&#34;allowEval&#34;:false,&#34;allowScriptTags&#34;:false,&#34;includeIndicatorStyles&#34;:false,&#34;historyCacheSize&#34;:0,&#34;selfRequestsOnly&#34;:true}"><link rel="icon" type="image/svg+xml" href="/-/assets/favicon.0123abcd.svg"><link rel="stylesheet" href="/-/assets/app.0123abcd.css"><script src="/-/assets/theme.0123abcd.js"></script><script src="/-/assets/htmx.min.0123abcd.js" defer></script><script src="/-/assets/app.0123abcd.js" defer></script></head><body class="flex min-h-screen flex-col bg-ground text-foreground" hx-headers="{&#34;X-CSRF-Token&#34;:&#34;tok\&#34;en\u003c&#34;}"><a class="cn-skip-link" href="#main">Skip to content</a><header data-slot="topbar" class="flex min-h-16 flex-wrap items-center gap-x-5 gap-y-2 border-b border-border bg-background px-6 max-sm:px-4"><a href="/" class="flex items-center gap-2.5" aria-label="Raun home"><span class="grid size-[30px] place-items-center rounded-[7px] bg-primary text-primary-foreground"><svg viewBox="0 0 16 16" class="cn-icon shrink-0 size-[18px]" data-icon="rune" aria-hidden="true" focusable="false"><path d="M5.2 2.4v11.2M5.2 2.8l5.2 2.9-5.2 2.8M5.2 8.5l6 5.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg></span> <span class="text-lg font-semibold tracking-tight">raun</span></a> <span class="h-6 w-px bg-border" aria-hidden="true"></span> <span class="font-mono text-[12.5px] text-muted-foreground">raun.acme.dev</span> <nav aria-label="Main" class="flex gap-0.5"><a class="cn-nav-link" href="/">Repositories</a><a class="cn-nav-link" href="/instance" aria-current="page">Instance settings</a></nav><span class="flex-1"></span> <span data-slot="account" class="font-mono text-[13px]">&lt;script&gt;alert(1)&lt;/script&gt;&#34; onmouseover=&#34;x</span><form method="post" action="/logout"><input type="hidden" name="csrf" value="tok&#34;en&lt;"><button type="submit" data-slot="button" class="cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap select-none disabled:pointer-events-none disabled:opacity-50 cn-button-variant-outline cn-button-size-sm">Log out</button></form><button type="button" class="cn-button inline-flex shrink-0 items-center justify-center whitespace-nowrap select-none disabled:pointer-events-none disabled:opacity-50 cn-button-variant-ghost cn-button-size-icon cn-theme-toggle" data-theme-toggle aria-label="Switch theme"><svg viewBox="0 0 16 16" class="cn-icon shrink-0 cn-when-light" data-icon="moon" aria-hidden="true" focusable="false"><path d="M13 9.6A5.5 5.5 0 0 1 6.4 3a5.5 5.5 0 1 0 6.6 6.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg><svg viewBox="0 0 16 16" class="cn-icon shrink-0 cn-when-dark" data-icon="sun" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle> <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button></header><main id="main" class="mx-auto flex w-full max-w-[1280px] flex-1 flex-col gap-6 px-8 pt-8 pb-12 max-sm:px-4"><h1 class="text-2xl font-semibold tracking-tight">Instance settings</h1><p class="max-w-3xl text-[13.5px] text-muted-foreground">The effective configuration of this instance, from its <span class="font-mono">RAUN_*</span> variables. It is read-only: changing a value means changing the variable and restarting the server. Every secret shows as <span class="font-mono">[redacted]</span>, whether it is set or not.</p><section data-slot="settings" class="cn-card overflow-x-auto"><div data-slot="table-container" class="cn-table-container"><table data-slot="table" class="cn-table" aria-label="Instance settings"><thead data-slot="table-header" class="cn-table-header"><tr data-slot="table-row" class="cn-table-row"><th scope="col" data-slot="table-head" class="cn-table-head">Variable</th><th scope="col" data-slot="table-head" class="cn-table-head">Value</th></tr></thead><tbody data-slot="table-body" class="cn-table-body"><tr data-slot="table-row" class="cn-table-row"><td data-slot="table-cell" class="cn-table-cell font-mono whitespace-nowrap">RAUN_HTTP_ADDR</td><td data-slot="table-cell" class="cn-table-cell font-mono break-all">:8080</td></tr><tr data-slot="table-row" class="cn-table-row"><td data-slot="table-cell" class="cn-table-cell font-mono whitespace-nowrap">RAUN_TLS_CERT_FILE</td><td data-slot="table-cell" class="cn-table-cell font-mono break-all"><span class="text-muted-foreground">empty</span></td></tr><tr data-slot="table-row" class="cn-table-row"><td data-slot="table-cell" class="cn-table-cell font-mono whitespace-nowrap">RAUN_SECRET_KEY</td><td data-slot="table-cell" class="cn-table-cell font-mono break-all">[redacted]</td></tr><tr data-slot="table-row" class="cn-table-row"><td data-slot="table-cell" class="cn-table-cell font-mono whitespace-nowrap">RAUN_ADMINS</td><td data-slot="table-cell" class="cn-table-cell font-mono break-all">&lt;script&gt;alert(1)&lt;/script&gt;&#34; onmouseover=&#34;x</td></tr></tbody></table></div></section></main></body></html>